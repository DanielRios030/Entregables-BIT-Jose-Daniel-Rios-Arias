        "    Encontrado = True\n",
        "    break\n",
        "\n",
        "print(\"CIUDAD DONDE VIVEN CADA UNO LOS ESTUDIANTES\")\n",
        "\n",
        "Ciudades = { \"Ana Rodriguez\" : \"Bogota\",\n",
        "    \"Carlos Montero\" : \"Medellin\",\n",
        "    \"Laura Sanchez\" : \"Bogota\",\n",
        "    \"Miguel Arias\" : \"Cartagena\",\n",
        "    \" Sofia Rios\" : \"Barranquilla\",\n",
        "    \"Juan Velez\": \"Cali\",\n",
        "    \"Valentina Ruiz\": \"Bucaramanga\" ,\n",
        "    \"Pedro Cuesta\" : \"Pereira\"}\n",
        "\n",
        "for nombre, ciudad in Ciudades.items():\n",
        "  print(f\"{nombre} vive en {ciudad}\")\n",
        "\n",
        "print(\"CANTIDAD DE ESTUDIANTES POR CIUDAD\")\n",
        "Cantidad_por_ciudad = {}\n",
        "for ciudad in Ciudades.values ():\n",
        "  if ciudad in Cantidad_por_ciudad:\n",
        "    Cantidad_por_ciudad[ciudad] += 1\n",
        "  else:\n",
        "    Cantidad_por_ciudad[ciudad] = 1\n",
        "\n",
        "print(Cantidad_por_ciudad)\n",
        "\n",
        "print (\"CICLO WHILE\")\n",
        "SUMA = 0\n",
        "CANTIDAD = 0\n",
        "while True:\n",
        "  numero = float(input(\"Ingrese un numero: \"))\n",
        "  if numero == 0:\n",
        "    break\n",
        "  SUMA += numero\n",
        "  CANTIDAD += 1\n",
        "if CANTIDAD > 0:\n",
        "  PROMEDIO = SUMA / CANTIDAD\n",
        "else:\n",
        "  promedio = 0\n",
        "\n",
        "print(f\"Cantidad de numeros ingresados: {CANTIDAD}\")\n",
        "print(f\"Suma total: {SUMA}\")\n",
        "print(f\"Promedio de los numeros ingresados: {PROMEDIO}\")\n",
        "\n",
        "for numero in range (1, 31):\n",
        "  if numero % 3 == 0:\n",
        "    continue\n",
        "  if numero == 25:\n",
        "    break\n",
        "  print(numero)\n",
        "\n"
