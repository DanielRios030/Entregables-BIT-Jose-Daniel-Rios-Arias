        "for estudiante in Estudiantes:\n",
        "  nombre, edad, nota = estudiante\n",
        "  suma_notas += nota\n",
        "  promedio = suma_notas / len(Estudiantes)\n",
        "\n",
        "print(f\"PROMEDIO DE LAS NOTAS: {promedio}\")\n",
        "\n",
        "print(\"BUSQUEDA DE ESTUDIANTES\")\n",
        "\n",
        "nombre_buscar = input(\"INGRESE EL NOMBRE DEL ESTUDIANTE QUE DESEASBUSCAR:\")\n",
        "Encontrado = False\n",
        "\n",
        "for estudiante in Estudiantes:\n",
