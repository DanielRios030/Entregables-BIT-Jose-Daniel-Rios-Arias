        "Estudiantes= [(\"Ana Rodriguez\", 20, 4.5),\n",
        "    (\"Carlos Montero\", 22, 4.2),\n",
        "    (\"Laura Sanchez\", 19, 3.8),\n",
        "    (\"Miguel Arias\", 21, 2.7),\n",
        "    (\"Sofia Rios\", 20, 4.7),\n",
        "    (\"Juan Velez\", 23, 3.5),\n",
        "    (\"Valentina Ruiz\", 18, 4.0),\n",
        "    (\"Pedro Cuesta\", 22, 2.9)]\n",
        "\n",
        "print (\"INFORMACION DE LOS ESTUDIANTES\")\n",
        "\n",
        "for estudiante in Estudiantes:\n",
        "  nombre, edad,nota = estudiante\n",
        "  print(f\"{nombre} tiene {edad} años y obtuvo una nota de {nota}\")\n",
        "\n",
        "print(\"CLASIFICACION DE LOS ESTUDIANTES\")\n",
        "\n",
        "for estudiante in Estudiantes:\n",
        "  nombre, edad, nota = estudiante\n",
        "  if nota>= 4.5:\n",
        "    clasificacion = \"EXCELENTE\"\n",
        "  elif nota >= 4.0:\n",
        "    clasificacion = \"BUENO\"\n",
        "  elif nota>= 3.0:\n",
        "    clasificacion = \"ACEPTABLE\"\n",
        "  else:\n",
        "    clasificacion = \"REPROBO\"\n",
        "\n",
        "  print(f\"{nombre} : {clasificacion}\")\n",
