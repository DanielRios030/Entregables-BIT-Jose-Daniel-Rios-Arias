        "#LIMPIEZA DE DATOS\n",
        "print(\"CREAR UNA COPIA E IDENTIFICAR VALORES FALTANTES\")\n",
        "df_clean = df.copy()\n",
        "print(\"VALORES FALTANTES ANTES DE LA LIMPIEZA:\")\n",
        "\n",
        "for col in df_clean.columns:\n",
        "    faltantes = df_clean[col].isnull().sum()\n",
        "\n",
        "    if faltantes > 0:\n",
        "        print(col, \":\", faltantes)\n",
        "\n",
        "#TRATAMEINTO DE VALORES FALTANTES DE LOS PAISES\n",
        "print (\"TRATAMIENTO DE VALORES FALTANTES:\")\n",
        "print(\"1) COUNTRY\")\n",
        "df_clean['Country'] = df_clean['Country'].fillna(\n",
        "    df_clean['Country'].mode()[0])\n",
        "\n",
        "print(\"2) GENDER\")\n",
        "df_clean['Gender'] = df_clean['Gender'].fillna(\n",
        "    df_clean['Gender'].mode()[0])\n",
        "\n",
        "print(\"3) ANIMAL CODE AND ANIMAL NAME\")\n",
        "df_clean = df_clean.drop(\n",
        "    columns=['Animal code', 'Animal name'], errors='ignore')\n",
        "\n",
        "print(\"4) LATITUDE AND LONGITUDE\")\n",
        "for col in ['Latitude', 'Longitude']:\n",
        "    df_clean[col] = df_clean[col].fillna(\n",
        "        df_clean[col].median()  )\n",
        "\n",
        "\n",
        "#VERIFICACION\n",
        "print(\"VALORES FALTANTES DESPUES DE LA LIMPIEZA:\")\n",
        "for col in df_clean.columns:\n",
        "    faltantes = df_clean[col].isnull().sum()\n",
        "    print(col, \":\", faltantes)\n",
        "\n",
        "#ELIMINAR REGISTROS DUPLICADOS\n",
        "print(\"DUPLICADOS ANTES DE LA LIMPIEZA:\", df.duplicated().sum())\n",
        "\n",
        "df_clean = df_clean.drop_duplicates().copy()\n",
        "\n",
        "print(\"DUPLICADOS DESPUÉS DE LA LIMPIEZA:\", df_clean.duplicated().sum())\n",
        "\n",
        "#CONVERTIR COLUMNAS CON TIPOS DE DATOS INCORRECTOS\n",
        "\n",
        "columnas_numericas = [\n",
        "    'Weight kg',\n",
        "    'Body Length cm',\n",
        "    'Latitude',\n",
        "    'Longitude']\n",
        "\n",
        "for col in columnas_numericas:\n",
        "    df_clean[col] = pd.to_numeric(\n",
        "        df_clean[col],\n",
        "        errors='coerce')\n",
        "\n",
        "# TRATAMIENTO DE PESOS NO POSITIVOS O FALTANTES\n",
        "print(\"5) TRATAMIENTO DE PESOS NO POSITIVOS O FALTANTES EN 'Weight kg'\")\n",
        "if 'Weight kg' in df_clean.columns:\n",
        "    # Reemplazar pesos <= 0 con NaN\n",
        "    df_clean.loc[df_clean['Weight kg'] <= 0, 'Weight kg'] = np.nan\n",
        "    # Rellenar cualquier NaN (incluyendo los recién creados) con la mediana\n",
        "    median_weight = df_clean['Weight kg'].median()\n",
